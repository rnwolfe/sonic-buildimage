From 2bee8451b5376ebc83243f6ab0091c38c0c21443 Mon Sep 17 00:00:00 2001
From: Ryan Wolfe <rnwolfe@google.com>
Date: Wed, 7 Oct 2026 20:59:56 -0400
Subject: [PATCH] bgpd: keep a configured L3VNI route-target that equals the
 auto RT

Configuring a route-target on an L3VNI VRF first removes the VRF's
auto-derived RT (evpn_auto_rt_import_delete_for_vrf). The removal matches
by value only, so a configured RT that happens to equal the auto RT (the
common "route-target both <ASN>:<L3VNI>") is removed instead, by whichever
route-target is configured after it. A VRF that imports its own RT plus
others then silently stops importing its own routes.

It depends on order: on a running bgpd that only adds the missing RTs it
does not show, but every fresh bgpd that loads a full configuration with
the VRF's own RT followed by other imports loses it. We hit it on SONiC
switches whose bgpd restarted: the external VRF dropped every type-2 host
route and type-5 prefix of its own VNI.

Only remove entries flagged BGP_VRF_RT_AUTO when deleting the auto RT.
FRR master no longer has this code: configured and derived route-targets
are kept apart since the typed route-target model (bbcee323ab and
following); this is the minimal fix for 10.5.

tests/topotests/bgp_evpn_rt5/test_bgp_evpn_rt5_dvni.py checks that
vrf-102 still imports its configured 65000:102 after importing 65000:101.

Signed-off-by: Ryan Wolfe <rnwolfe@google.com>
---
 bgpd/bgp_evpn.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/bgpd/bgp_evpn.c b/bgpd/bgp_evpn.c
index f874f17e0a..446e5134b0 100644
--- a/bgpd/bgp_evpn.c
+++ b/bgpd/bgp_evpn.c
@@ -5623,7 +5623,8 @@ void bgp_evpn_advertise_type5_routes(struct bgp *bgp_vrf, afi_t afi,
 }
 
 static void rt_list_remove_node(struct list *rt_list,
-				struct ecommunity *ecomdel, bool is_l3)
+				struct ecommunity *ecomdel, bool is_l3,
+				bool only_auto)
 {
 	struct listnode *node = NULL, *nnode = NULL, *node_to_del = NULL;
 	struct vrf_route_target *l3rt = NULL;
@@ -5631,6 +5632,9 @@ static void rt_list_remove_node(struct list *rt_list,
 
 	if (is_l3) {
 		for (ALL_LIST_ELEMENTS(rt_list, node, nnode, l3rt)) {
+			/* A configured RT can have the auto RT's value */
+			if (only_auto && !CHECK_FLAG(l3rt->flags, BGP_VRF_RT_AUTO))
+				continue;
 			if (ecommunity_match(l3rt->ecom, ecomdel)) {
 				evpn_vrf_rt_del(l3rt);
 				node_to_del = node;
@@ -5666,7 +5670,7 @@ void evpn_rt_delete_auto(struct bgp *bgp, vni_t vni, struct list *rtl,
 	ecom_auto = ecommunity_new();
 	ecommunity_add_val(ecom_auto, &eval, false, false);
 
-	rt_list_remove_node(rtl, ecom_auto, is_l3);
+	rt_list_remove_node(rtl, ecom_auto, is_l3, true);
 
 	ecommunity_free(&ecom_auto);
 }
@@ -5783,7 +5787,7 @@ void bgp_evpn_unconfigure_import_rt_for_vrf(struct bgp *bgp_vrf,
 	evpn_vrf_rt_routes_unmap(bgp_vrf);
 
 	/* Remove rt */
-	rt_list_remove_node(bgp_vrf->vrf_import_rtl, ecomdel, true);
+	rt_list_remove_node(bgp_vrf->vrf_import_rtl, ecomdel, true, false);
 
 	if (!rt_list_has_cfgd_rt(bgp_vrf->vrf_import_rtl))
 		UNSET_FLAG(bgp_vrf->vrf_flags, BGP_VRF_IMPORT_RT_CFGD);
@@ -5852,7 +5856,7 @@ void bgp_evpn_unconfigure_export_rt_for_vrf(struct bgp *bgp_vrf,
 		return; /* Already un-configured */
 
 	/* Remove rt */
-	rt_list_remove_node(bgp_vrf->vrf_export_rtl, ecomdel, true);
+	rt_list_remove_node(bgp_vrf->vrf_export_rtl, ecomdel, true, false);
 
 	if (!rt_list_has_cfgd_rt(bgp_vrf->vrf_export_rtl))
 		UNSET_FLAG(bgp_vrf->vrf_flags, BGP_VRF_EXPORT_RT_CFGD);
-- 
