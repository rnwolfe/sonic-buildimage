From dc43e1b9a10e8a4e962057b8d2b82c4b70b2e012 Mon Sep 17 00:00:00 2001
From: Ryan Wolfe <rnwolfe@google.com>
Date: Thu, 8 Oct 2026 17:57:03 -0400
Subject: [PATCH] bgpd: install one VNI per VTEP for an EVPN multipath

A VTEP that originates the same prefix from several VRFs sends one type-5
route per VRF, each with that VRF's VNI. A border leaf does this when it
aggregates routes that are leaked between its VRFs. A VRF elsewhere that
imports more than one of those route-targets gets paths that differ only
in their VNI: same nexthop, same attributes. Multipath takes them all,
bgp_zebra_announce_parse_nexthop() sends zebra one nexthop per path, and
zebra keeps them apart because their EVPN labels differ (and, without an
SVD, gives each its own VNI as encap). The dataplane gets an ECMP to one
VTEP across VNIs. That VTEP decapsulates each VNI into a different VRF,
so part of the flows land in a VRF the best path did not choose, where
the prefix may be nothing but the aggregate's discard route.

Whether such paths become multipath at all is close to random today:
bgp_path_info_cmp() refuses to multipath two paths when only one "has a
label", and bgp_is_valid_label() reads bit 1 of the label's last byte,
which for an EVPN label is bit 1 of the VNI. VNIs 1904 and 2157 multipath,
VNIs 101 and 102 do not.

Install one VNI per VTEP: the best path's VNI if the VTEP advertised it,
else the VNI of its first multipath. The RIB keeps the multipath; only the
nexthops sent to zebra change. Paths that repeat a VTEP and its VNI still
go to zebra, which treats identical nexthops as duplicates
(test_evpn_multipath relies on that). ECMP across different VTEPs is
untouched, including VTEPs that use different VNIs (downstream VNI).
Gateway-IP paths, which resolve through the gateway rather than the VTEP,
are left alone.

tests/topotests/bgp_evpn_rt5/test_bgp_evpn_rt5_dvni.py has r2's vrf-102
import one prefix from r1's vrf-102 (VNI 102) and vrf-103 (VNI 103), and
checks the FPM gets one nexthop, with the best path's VNI. Without this
change it gets VNIs 102 and 103, with or without the NHT backport
(ae614f4871) and with the older recursive-nexthop patch in place of
FRRouting/frr#19720. bgp_evpn_rt5 (including test_evpn_multipath),
bgp_evpn_rt5_addpath, bgp_evpn_vxlan_topo1, bgp_evpn_vxlan_svd_topo1,
bgp_evpn_vxlan_macvrf_soo_topo1, bgp_evpn_mh and
bgp_evpn_overlay_index_gateway_irb pass.

Signed-off-by: Ryan Wolfe <rnwolfe@google.com>
---
 bgpd/bgp_zebra.c | 54 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/bgpd/bgp_zebra.c b/bgpd/bgp_zebra.c
index ca53e188aa..9e3f088f8d 100644
--- a/bgpd/bgp_zebra.c
+++ b/bgpd/bgp_zebra.c
@@ -1222,6 +1222,57 @@ static bool bgp_zebra_use_nhop_weighted(struct bgp *bgp, struct attr *attr,
 	return true;
 }
 
+/* Is this a VRF path imported from an EVPN route, forwarded with its VNI? */
+static bool bgp_zebra_is_evpn_vni_path(struct bgp_path_info *pi)
+{
+	struct bgp_route_evpn *bre = bgp_attr_get_evpn_overlay(pi->attr);
+
+	return is_route_parent_evpn(pi) && BGP_PATH_INFO_NUM_LABELS(pi) &&
+	       !(bre && bre->type == OVERLAY_INDEX_GATEWAY_IP);
+}
+
+static mpls_label_t bgp_zebra_evpn_path_l3vni(struct bgp_path_info *pi)
+{
+	return *bgp_evpn_path_info_labels_get_l3vni(pi->extra->labels->label,
+						    BGP_PATH_INFO_NUM_LABELS(pi));
+}
+
+/*
+ * EVPN paths from the same VTEP can differ only in their VNI, when the VTEP
+ * originates a prefix from several VRFs and this VRF imports more than one
+ * of them. Multipath may take them all, but the VTEP decapsulates each VNI
+ * into a different VRF, so an ECMP across them sends part of the flows
+ * into a VRF the best path did not choose. Install one VNI per VTEP: the
+ * best path's if the VTEP advertised it, else the VNI of its first path.
+ * Paths with the same VTEP and VNI stay, zebra treats them as duplicates.
+ * Returns true if pi has another VNI.
+ */
+static bool bgp_zebra_evpn_mpath_skip(struct bgp_path_info *best, struct bgp_path_info *pi)
+{
+	struct bgp_path_info *cand, *first = NULL;
+	bool best_is_evpn;
+
+	if (pi == best || !bgp_zebra_is_evpn_vni_path(pi))
+		return false;
+
+	best_is_evpn = bgp_zebra_is_evpn_vni_path(best);
+
+	for (cand = best; cand; cand = bgp_path_info_mpath_next(cand)) {
+		if (!bgp_zebra_is_evpn_vni_path(cand) || bgp_path_info_nexthop_cmp(cand, pi))
+			continue;
+
+		if (best_is_evpn &&
+		    bgp_zebra_evpn_path_l3vni(cand) == bgp_zebra_evpn_path_l3vni(best))
+			return bgp_zebra_evpn_path_l3vni(pi) != bgp_zebra_evpn_path_l3vni(best);
+
+		if (!first)
+			first = cand;
+	}
+
+	/* pi itself is one of the multipaths, so first is set */
+	return first && bgp_zebra_evpn_path_l3vni(pi) != bgp_zebra_evpn_path_l3vni(first);
+}
+
 static void bgp_zebra_announce_parse_nexthop(
 	struct bgp_path_info *info, const struct prefix *p, struct bgp *bgp,
 	struct zapi_route *api, unsigned int *valid_nh_count, afi_t afi,
@@ -1272,6 +1323,9 @@ static void bgp_zebra_announce_parse_nexthop(
 		if (*valid_nh_count >= multipath_num)
 			break;
 
+		if (bgp_zebra_evpn_mpath_skip(info, mpinfo))
+			continue;
+
 		*mpinfo_cp = *mpinfo;
 		nh_weight = 0;
 
