From 354961feb9f027f35aef5136fb04303c641a8e32 Mon Sep 17 00:00:00 2001
From: Ryan Wolfe <rnwolfe@google.com>
Date: Wed, 7 Oct 2026 17:12:20 -0400
Subject: [PATCH] zebra: install EVPN downstream VNI routes without an SVD

A type-5 route imported into a VRF whose L3VNI differs from the route's
VNI is a downstream VNI (D-VNI) route. nexthop_set_evpn_dvni_svd() only
handles that case when the VRF's L3VNI rides a single VXLAN device; with
a VXLAN device per VNI, which is how SONiC builds L3VNIs, it logs
"D-VNI but route's vrf ... doesn't use SVD" and the route is never
installed. Leaking routes between VRFs by route-target import is
therefore impossible on those systems.

Without an SVD the kernel nexthop cannot carry a per-route VNI, but the
dataplane behind the FPM can. Keep the nexthop on the importing VRF's
L3VNI SVI with its EVPN label, and:

- in dplane_ctx_route_init(), take the encap VNI from the route's EVPN
  label rather than from the VRF's L3VNI, so the FPM gets the VNI the
  remote VTEP decapsulates into (the hunk from FRRouting/frr#23468);
- in rt_netlink, encode an EVPN label as VXLAN encap for the kernel only
  when the nexthop is on the SVD, and never encode it as an MPLS label,
  so the kernel route on the SVI is a plain onlink route. A nexthop
  group sent to the FPM always keeps the encap: with "fpm
  use-next-hop-groups", the default, the route message carries only the
  group id, and the group is the only place the VNI can go. SONiC runs
  "no fpm use-next-hop-groups", so it does not take that path, but it is
  kept to match upstream.

The netlink encoders run on the dataplane and FPM threads, so they can't
look up the nexthop's interface to tell the two cases apart. Instead
nexthop_set_evpn_dvni_svd() sets the new NEXTHOP_FLAG_EVPN_SVD, on the
main thread, when it moves a nexthop onto the SVD, and a recursively
resolved nexthop inherits it. The flag is not part of nexthop_hash() or
nexthop_cmp(), and SVD routes are encoded as before.

tests/topotests/bgp_evpn_rt5/test_bgp_evpn_rt5_dvni.py imports vrf-101's
route-target into vrf-102 on a per-VNI VXLAN topology and checks that
the route is installed on bridge-102 and reaches the FPM with VNI 101,
both inline in the route message and in a nexthop group. It fails
without this change.

Signed-off-by: Ryan Wolfe <rnwolfe@google.com>
---
 lib/nexthop.h        |  1 +
 zebra/rt_netlink.c   | 21 +++++++++++++++++++--
 zebra/zebra_dplane.c | 18 +++++++++++++++++-
 zebra/zebra_nhg.c    | 22 ++++++++++++++++++++--
 4 files changed, 57 insertions(+), 5 deletions(-)

diff --git a/lib/nexthop.h b/lib/nexthop.h
index f45734e..b5337c6 100644
--- a/lib/nexthop.h
+++ b/lib/nexthop.h
@@ -120,6 +120,7 @@ struct nexthop {
 #define NEXTHOP_FLAG_SRTE       (1 << 7) /* SR-TE color used for BGP traffic */
 #define NEXTHOP_FLAG_EVPN       (1 << 8) /* nexthop is EVPN */
 #define NEXTHOP_FLAG_LINKDOWN   (1 << 9) /* is not removed on link down */
+#define NEXTHOP_FLAG_EVPN_SVD	   (1 << 10) /* EVPN label is a VXLAN encap on an SVD */
 
 	/* which flags are part of nexthop_hash().  Should probably be split
 	 * off into a separate field...
diff --git a/zebra/rt_netlink.c b/zebra/rt_netlink.c
index 42fa0b1..462017d 100644
--- a/zebra/rt_netlink.c
+++ b/zebra/rt_netlink.c
@@ -1786,6 +1786,16 @@ static bool _netlink_route_encode_label_info(const struct nexthop *nexthop,
 				       label_buf, label_buf_size);
 
 	if (num_labels && nh_label_type == ZEBRA_LSP_EVPN) {
+		/*
+		 * A downstream-VNI label is a route encap only when
+		 * nexthop_set_evpn_dvni_svd() moved the nexthop onto the SVD.
+		 * Without an SVD the nexthop stays on the L3VNI SVI, the kernel
+		 * route is a plain onlink route, and an FPM dataplane gets the
+		 * VNI from nh_encap instead.
+		 */
+		if (!CHECK_FLAG(nexthop->flags, NEXTHOP_FLAG_EVPN_SVD))
+			return true;
+
 		if (!nl_attr_put16(nlmsg, buflen, RTA_ENCAP_TYPE,
 				   LWTUNNEL_ENCAP_IP))
 			return false;
@@ -3325,7 +3335,13 @@ ssize_t netlink_nexthop_msg_encode(uint16_t cmd,
 				nh->nh_label, nh->nh_label_type, out_lse,
 				label_buf, sizeof(label_buf));
 
-			if (num_labels && nh->nh_label_type == ZEBRA_LSP_EVPN) {
+			/*
+			 * Without an SVD the kernel nexthop stays on the L3VNI
+			 * SVI with no encap, but an FPM peer using nexthop
+			 * groups gets the downstream VNI only from here.
+			 */
+			if (num_labels && nh->nh_label_type == ZEBRA_LSP_EVPN &&
+			    (fpm || CHECK_FLAG(nh->flags, NEXTHOP_FLAG_EVPN_SVD))) {
 				if (!nl_attr_put16(&req->n, buflen,
 						   NHA_ENCAP_TYPE,
 						   nh_afi))
@@ -3342,7 +3358,8 @@ ssize_t netlink_nexthop_msg_encode(uint16_t cmd,
 
 				nl_attr_nest_end(&req->n, nest);
 
-			} else if (num_labels) {
+			} else if (num_labels &&
+				   nh->nh_label_type != ZEBRA_LSP_EVPN) {
 				/* Set the BoS bit */
 				out_lse[num_labels - 1] |=
 					htonl(1 << MPLS_LS_S_SHIFT);
diff --git a/zebra/zebra_dplane.c b/zebra/zebra_dplane.c
index 17adb66..72cdbda 100644
--- a/zebra/zebra_dplane.c
+++ b/zebra/zebra_dplane.c
@@ -3862,9 +3862,25 @@ int dplane_ctx_route_init(struct zebra_dplane_ctx *ctx, enum dplane_op_e op,
 			continue;
 
 		zl3vni = zl3vni_from_vrf(nexthop->vrf_id);
+		if (!zl3vni || !is_l3vni_oper_up(zl3vni))
+			zl3vni = zl3vni_from_vrf(re->vrf_id);
 		if (zl3vni && is_l3vni_oper_up(zl3vni)) {
+			struct mpls_label_stack *labels = nexthop->nh_label;
+			vni_t encap_vni = zl3vni->vni;
+
+			/*
+			 * Default encap is this VRF's L3VNI. A downstream-VNI
+			 * nexthop keeps the VNI of the VRF that originated the
+			 * route as its EVPN label, and that is the VNI the
+			 * remote VTEP decapsulates into.
+			 */
+			if (labels && nexthop->nh_label_type == ZEBRA_LSP_EVPN &&
+			    labels->num_labels)
+				encap_vni = label2vni(
+					&labels->label[labels->num_labels - 1]);
+
 			nexthop->nh_encap_type = NET_VXLAN;
-			nexthop->nh_encap.encap_data.vni = zl3vni->vni;
+			nexthop->nh_encap.encap_data.vni = encap_vni;
 		}
 	}
 
diff --git a/zebra/zebra_nhg.c b/zebra/zebra_nhg.c
index ebde938..250ae0c 100644
--- a/zebra/zebra_nhg.c
+++ b/zebra/zebra_nhg.c
@@ -1948,6 +1948,10 @@ static struct nexthop *nexthop_set_resolved(afi_t afi,
 		nexthop_add_labels(resolved_hop, label_type, num_labels,
 				   labels);
 
+	/* The resolved hop inherits the SVD and its EVPN label encap */
+	if (CHECK_FLAG(newhop->flags, NEXTHOP_FLAG_EVPN_SVD))
+		SET_FLAG(resolved_hop->flags, NEXTHOP_FLAG_EVPN_SVD);
+
 	if (nexthop->nh_srv6) {
 		if (nexthop->nh_srv6->seg6local_action !=
 		    ZEBRA_SEG6_LOCAL_ACTION_UNSPEC)
@@ -2025,19 +2029,33 @@ static bool nexthop_set_evpn_dvni_svd(vrf_id_t re_vrf_id,
 				      struct nexthop *nexthop)
 {
 	if (!is_vrf_l3vni_svd_backed(re_vrf_id)) {
+		/*
+		 * Without an SVD the kernel cannot carry the downstream VNI as
+		 * a route encap: each VNI has its own VXLAN device, and the
+		 * nexthop sits on the VRF's L3VNI SVI. Keep it there, with its
+		 * label, rather than refusing the route. A dataplane fed over
+		 * FPM encapsulates with the label's VNI (see
+		 * dplane_ctx_route_init()), which is how a route leaked between
+		 * VRFs with different L3VNIs is forwarded asymmetrically.
+		 */
 		if (IS_ZEBRA_DEBUG_NHG_DETAIL) {
 			struct vrf *vrf = vrf_lookup_by_id(re_vrf_id);
 
 			zlog_debug(
-				"nexthop %pNHv D-VNI but route's vrf %s(%u) doesn't use SVD",
+				"nexthop %pNHv D-VNI on vrf %s(%u) without SVD, keeping the L3VNI SVI",
 				nexthop, VRF_LOGNAME(vrf), re_vrf_id);
 		}
 
-		return false;
+		return true;
 	}
 
 	nexthop->ifindex = get_l3vni_vxlan_ifindex(re_vrf_id);
 	nexthop->vrf_id = 0;
+	/*
+	 * Tell the dataplane encoders, which must not look up interfaces,
+	 * that the EVPN label is now a VXLAN encap on the SVD.
+	 */
+	SET_FLAG(nexthop->flags, NEXTHOP_FLAG_EVPN_SVD);
 
 	if (IS_ZEBRA_DEBUG_NHG_DETAIL)
 		zlog_debug("nexthop %pNHv using SVD", nexthop);
-- 
